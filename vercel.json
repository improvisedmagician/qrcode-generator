{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "redirect",
          "format": "url",
          "env": "REDIRECT_URL"
        }
      ]
    },
    "redirect": {
      "root": "services/redirect",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
